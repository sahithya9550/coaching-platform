# LOCAL: npm run setup generates .env with a password hash and session secret.
DB_PROVIDER=sqlite
PORT=3000
# HOSTED: set these in your host's secret environment settings.
# DB_PROVIDER=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=SERVER_ONLY_SECRET
# ADMIN_PASSWORD=YOUR_12_OR_MORE_CHARACTER_PASSWORD
# SESSION_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# NODE_ENV=production
