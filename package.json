{
  "name": "riit-bharat-mentors-standalone",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env server/index.mjs",
    "prebuild": "npm test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.1"
  }
}
